<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edits">
  <select id="find" resultType="map">SELECT * FROM edit_requests WHERE id=#{args[0]}</select>
  <select id="byNovel" resultType="map">SELECT * FROM edit_requests WHERE novel_id=#{args[0]} ORDER BY created_at DESC LIMIT 30</select>
  <insert id="create">INSERT INTO edit_requests(id,novel_id,chapter_no,base_version,instruction,impact,status) VALUES(#{args[0]},#{args[1]},#{args[2]},#{args[3]},#{args[4]},#{args[5]},'PENDING')</insert>
  <update id="approve">UPDATE edit_requests SET status='APPROVED' WHERE id=#{args[0]}</update>
</mapper>
