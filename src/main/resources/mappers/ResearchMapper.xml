<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="research">
  <select id="find" resultType="map">SELECT * FROM research WHERE id=#{args[0]}</select>
  <select id="lock" resultType="map">SELECT * FROM research WHERE id=#{args[0]} FOR UPDATE</select>
  <select id="all" resultType="map">SELECT * FROM research ORDER BY created_at DESC LIMIT 30</select>
  <select id="messages" resultType="map">SELECT * FROM research_messages WHERE research_id=#{args[0]} ORDER BY id</select>
  <select id="recent" resultType="map">SELECT role,content FROM research_messages WHERE research_id=#{args[0]} ORDER BY id DESC LIMIT 12</select>
  <insert id="create">INSERT INTO research(id,task_id,sources,ideas,brief) VALUES(#{args[0]},#{args[1]},#{args[2]},#{args[3]},#{args[4]})</insert>
  <insert id="userMessage">INSERT INTO research_messages(research_id,role,content,task_id) VALUES(#{args[0]},'USER',#{args[1]},#{args[2]})</insert>
  <insert id="reply">INSERT INTO research_messages(research_id,role,content,ideas,task_id) VALUES(#{args[0]},'ASSISTANT',#{args[1]},#{args[2]},#{args[3]})</insert>
  <update id="ideas">UPDATE research SET ideas=#{args[0]} WHERE id=#{args[1]}</update>
</mapper>
